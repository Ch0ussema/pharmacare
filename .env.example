# ---------------------------------------------------------------------------
# PharmaCare — environment variables
#
# Copy this file to `.env.local` (never committed) and fill in the values from
# your Supabase project (Project Settings → API).
#
# SECURITY: the secret key bypasses Row Level Security. It must only be read
# on the server (see `src/lib/supabase/admin.ts`) and never prefixed with
# NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Service-role / secret key used by the server only.
SUPABASE_SECRET_KEY=
